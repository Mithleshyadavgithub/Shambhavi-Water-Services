# ── Render Backend Deployment Environment Variables ────────
# Set these in your Render Web Service > Environment Variables
PORT=5001
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.osyft2r.mongodb.net/shambhavi_water?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shambhavi_water?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=shambhavi_water_jwt_secret_key_2026
JWT_EXPIRE=7d

# Frontend Vercel URL for CORS (Optional, auto-supported)
FRONTEND_URL=https://your-shambhavi-app.vercel.app

# Razorpay Keys (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# AI Engine Policy Limits
AI_MAX_ORDER_AMOUNT=5000
AI_MAX_DISCOUNT_PERCENT=15
AI_MAX_CAMPAIGN_BUDGET=2000
